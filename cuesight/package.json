{
  "name": "cuesight",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time pool & snooker shot trainer in your pocket: point the camera, get aim, power, spin and cue-ball path.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "tsx scripts/make-fake-camera.ts && tsx scripts/make-snap-fixtures.ts",
    "e2e": "npm run fixtures && vite build && playwright test --trace off",
    "icons": "node scripts/make-icons.cjs",
    "cap:sync": "vite build && cap sync ios",
    "ios:sync": "npm run cap:sync",
    "ios:open": "cap open ios",
    "e2e:webkit": "vite build && playwright test -c playwright.webkit.config.ts --trace off"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
